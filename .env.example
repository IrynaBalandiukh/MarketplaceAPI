# HTTP port the API listens on (integer 1-65535, default 3000).
PORT=3000

# Connection URL of the database (required): postgres://USER[:PASSWORD]@HOST:PORT/DATABASE.
# Leave the password out and use DB_PASSWORD_FILE below (rotation without a restart). If you do put
# one in, it is a fake dev value, never a real one. Inside Docker Compose the host is postgres.
DB_URL=postgres://app@localhost:5432/marketplace

# Path to the file with the database password (required). The password itself never lives in env.
# Copy secrets/db_password.example to secrets/db_password for local development.
DB_PASSWORD_FILE=./secrets/db_password
