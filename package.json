{
  "name": "marketplace-api",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "lint:spec": "node scripts/lint-spec.mjs",
    "check:env": "npm run build && node scripts/check-env-example.mjs",
    "db:rotate": "bash scripts/rotate.sh",
    "db:schema": "docker compose exec -T postgres psql -U app -d marketplace -v ON_ERROR_STOP=1 -1 < db/schema.sql",
    "db:indexes": "docker compose exec -T postgres psql -U app -d marketplace -v ON_ERROR_STOP=1 -1 < db/indexes.sql",
    "db:seed": "docker compose exec -T postgres psql -U app -d marketplace -v ON_ERROR_STOP=1 < db/seed.sql"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "type": "module"
}
